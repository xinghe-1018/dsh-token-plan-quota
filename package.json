{
  "name": "dsh-token-plan-quota",
  "version": "0.2.0",
  "description": "DeepSeek Harness Web 插件：输入框工具行的额度徽标，跟随当前模型供应商切换——DeepSeek 官方余额（/user/balance）、千问 Token Plan 实测 7 天窗口（本实例账本，标「实测」）、可选阿里云 BssOpenApi（AK/SK）。含模型可调用工具 token_plan_quota。Token quota chip that follows the active model's provider for the DeepSeek Harness web GUI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0-rc.5"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-token-plan-quota",
    "summary": "额度徽标跟随当前模型供应商：DeepSeek 官方 /user/balance 真值 + 千问 Token Plan 实测 7 天窗口（本实例账本，明确标注非官方余量）+ 可选阿里云 BssOpenApi（AK/SK）资源包/余额；实测吞吐速度（tokens÷流式活跃秒）按供应商归因，徽标以纯文本 NN tok/s 显示；幽灵小徽标，余量渐变条即状态表达（无圆点、无表情符号），点开明细面板看全部源；附带 token_plan_quota 模型工具。",
    "categories": ["费用", "Web UI", "观测"],
    "surfaces": ["host", "web"],
    "capabilities": { "provides": ["tool:token_plan_quota"] },
    "compatibility": { "dsh": ">=0.1.0-rc.5", "node": ">=20" },
    "permissions": {
      "network": [
        "https://api.deepseek.com",
        "https://api.moonshot.cn",
        "https://api.moonshot.ai",
        "https://openrouter.ai",
        "https://business.aliyuncs.com",
        "https://cs-data.qianwenai.com",
        "https://platform-home.qianwenai.com",
        "https://cdn.jsdelivr.net"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinghe-1018/dsh-token-plan-quota.git"
  },
  "homepage": "https://github.com/xinghe-1018/dsh-token-plan-quota#readme",
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": {
    "test": "node test/host.mjs && node test/client.mjs",
    "test:host": "node test/host.mjs",
    "test:client": "node test/client.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "client-plugin",
    "aliyun",
    "bailian",
    "qwen",
    "model-studio",
    "token-plan",
    "quota",
    "balance",
    "bssopenapi"
  ],
  "license": "MIT",
  "engines": { "node": ">=20" }
}
